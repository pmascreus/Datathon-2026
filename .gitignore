# Secrets — never commit
.env

# Runtime state (seen-journal + telemetry, regenerated by serve.py)
state/

# Model artefacts are NOT committed: 48 MB, and users.pkl alone holds 59,149
# real user ids from the shop. Only the cut metadata travels with the code;
# rebuild the rest with `python train.py --until 2026-11-13 --tag 2026-11-13r`.
models/*
!models/2026-11-13r/
models/2026-11-13r/*
!models/2026-11-13r/meta.json

# Python
__pycache__/
*.pyc
.pytest_cache/
